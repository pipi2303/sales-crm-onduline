// =====================================================================
// Fase 1 — Fondasi (backend & auth nyata)
// =====================================================================
// This schema is the executable source of truth for Fase 1's five items
// (see the plan doc, Bab 4): a single real backend, a home for data that
// today lives only in localStorage, real password-hashed auth with
// backend-validated sessions, RBAC enforced at the API level (not just
// UI), and one consistent model for Client/Opportunity/Lead/Product.
//
// STATUS: schema only — no DATABASE_URL is configured yet, so nothing
// here has been run against a live database (per the plan doc's own
// checklist item, the Vercel Postgres/Neon project itself isn't
// provisioned). `npx prisma validate` / `generate` work without a live
// DB; `npx prisma migrate dev` needs DATABASE_URL set first — see
// .env.example.
//
// Supersedes db/migrations/0001_unified_product_model.sql as the
// design-of-record for products/sales_reps/territories/performance_targets
// (that file's rationale comments are preserved here); once a real DB
// exists, Prisma Migrate generates the actual SQL from this file instead
// of that hand-written one.
//
// Modeling calls worth flagging:
// - Opportunity in src/types/opportunity.ts has ~40 UI-only optional
//   fields (Overview/Commercial/Technical Detail sections, sales-process
//   scoring) that are still evolving and mostly not queried by anything
//   except the detail dialog. Turning each into its own nullable column
//   would make the table unreviewable, so the stable/queried fields are
//   real columns and the long tail lives in `extra Json`. If a specific
//   field there needs to be filtered/sorted on later, promote it to a
//   real column then.
// - Client/Opportunity keep their existing free-text clientName/
//   contactPerson columns (matches current UI + localStorage data, so
//   migration doesn't require backfilling a relation that doesn't exist
//   yet) AND get a new optional clientId FK, so the UI can start linking
//   to real Client records incrementally without a breaking migration.
// - Distributor/Store/Client all carry `code` (Bab 4/5 "kode distributor/
//   toko/customer") as a plain unique column rather than a separate code
//   table — there's no indication codes are reused across entities or
//   have their own lifecycle independent of the record they identify.
// - GPS + dated-photo fields exist now on Store/Distributor/Task per the
//   plan doc's explicit warning (Bab 4): adding hierarchy/GPS/photo later
//   is much more expensive than designing for it from Fase 1, even though
//   the check-in UI feature itself is not part of Fase 1's own 5 items.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled (pgbouncer) connection doesn't support the prepared
  // statements `prisma migrate` needs, so migrations run over this
  // separate unpooled connection instead — same database, different port.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// Auth & RBAC (Fase 1 items 3 & 4)
// ---------------------------------------------------------------------

// Mirrors the roles already in use by src/app/components/Login.tsx's demo
// accounts. MASTER_DATA_ADMIN is added as a candidate approver for
// Distributor/Store verification — Bab 9's open question ("Sales Manager
// regional atau tim Master Data/Admin?") isn't decided yet, so both
// candidates exist in the enum rather than blocking the schema on it.
enum Role {
  SUPER_ADMIN
  SALES_MANAGER
  SALES_REPRESENTATIVE
  SALES_EXECUTIVE
  MASTER_DATA_ADMIN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  // Hashed server-side (bcrypt/argon2) — never store or accept a plaintext
  // password past the login request. Item 3: "password di-hash di server".
  passwordHash String    @map("password_hash")
  name         String
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions              Session[]
  auditEntries          AuditLogEntry[]
  distributorsSubmitted Distributor[]   @relation("DistributorSubmittedBy")
  distributorsDecided   Distributor[]   @relation("DistributorDecidedBy")
  storesSubmitted       Store[]         @relation("StoreSubmittedBy")
  storesDecided         Store[]         @relation("StoreDecidedBy")
  clientsSubmitted      Client[]        @relation("ClientSubmittedBy")
  clientsDecided        Client[]        @relation("ClientDecidedBy")
  opportunitiesOwned    Opportunity[]   @relation("OpportunityOwner")
  tasksOwned            Task[]          @relation("TaskOwner")
  distributorsAssigned  Distributor[]   @relation("DistributorSalesRep")
  storesAssigned        Store[]         @relation("StoreSalesRep")
  clientContactsCreated ClientContact[] @relation("ClientContactCreatedBy")
  clientIntelUpdated    ClientIntelligence[] @relation("ClientIntelligenceUpdatedBy")
  clientCommunicationsCreated ClientCommunication[] @relation("ClientCommunicationCreatedBy")

  @@map("users")
}

// A backend-issued, backend-validated session — item 3: "session/token
// divalidasi backend", not just trusted from whatever the client sends.
// Only the token's hash is stored; the raw token is returned to the
// client once at login/refresh and never persisted.
model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("sessions")
  @@index([userId])
}

// ---------------------------------------------------------------------
// Distributor / Store hierarchy + approval workflow (Bab 4, Bab 5, Bab 9)
// ---------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Distributor {
  id            String         @id @default(uuid())
  code          String         @unique // "kode distributor"
  name          String
  address       String?
  gpsLat        Float?         @map("gps_lat")
  gpsLng        Float?         @map("gps_lng")

  // Bab 9 approval workflow — field list matches "Field minimal" exactly.
  status         ApprovalStatus @default(PENDING)
  submittedById  String?        @map("submitted_by_id")
  submittedBy    User?          @relation("DistributorSubmittedBy", fields: [submittedById], references: [id])
  submittedAt    DateTime?      @map("submitted_at")
  decidedById    String?        @map("decided_by_id")
  decidedBy      User?          @relation("DistributorDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?      @map("decided_at")
  rejectionNote  String?        @map("rejection_note") // "khusus jika ditolak"

  // Bab 12 follow-up (distribusi beban per sales rep, 23 Sep 2026): siapa
  // yang menangani akun Distributor ini sehari-hari -- BEDA dari
  // submittedBy/decidedBy (siapa yang mengajukan/menyetujui). Ditugaskan
  // oleh approver lewat PUT (DISTRIBUTOR_APPROVER_ROLES), sama seperti
  // approve/reject. Menunjuk ke User (bukan model SalesRep terpisah yang
  // cuma dipakai untuk KPI/commission, dan bukan Karyawan yang malah
  // localStorage-only) supaya konsisten dengan Opportunity.ownerId/
  // Task.ownerId -- satu-satunya model "orang" yang benar-benar terhubung
  // ke akun login & RBAC.
  salesRepId String? @map("sales_rep_id")
  salesRep   User?   @relation("DistributorSalesRep", fields: [salesRepId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stores  Store[]
  clients Client[]

  @@map("distributors")
  @@index([salesRepId])
}

model Store {
  id            String         @id @default(uuid())
  code          String         @unique // "kode toko"
  name          String
  distributorId String?        @map("distributor_id")
  distributor   Distributor?   @relation(fields: [distributorId], references: [id])
  address       String?
  gpsLat        Float?         @map("gps_lat")
  gpsLng        Float?         @map("gps_lng")

  status         ApprovalStatus @default(PENDING)
  submittedById  String?        @map("submitted_by_id")
  submittedBy    User?          @relation("StoreSubmittedBy", fields: [submittedById], references: [id])
  submittedAt    DateTime?      @map("submitted_at")
  decidedById    String?        @map("decided_by_id")
  decidedBy      User?          @relation("StoreDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?      @map("decided_at")
  rejectionNote  String?        @map("rejection_note")

  // Bab 12 follow-up -- lihat komentar yang sama di model Distributor.
  salesRepId String? @map("sales_rep_id")
  salesRep   User?   @relation("StoreSalesRep", fields: [salesRepId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clients Client[]
  tasks   Task[]

  @@map("stores")
  @@index([salesRepId])
}

// Sales project (B2B) vs sales retail (toko) — "dua alur kerja berbeda"
// (Bab 5). Lives on Client and Opportunity since both need to know which
// flow a record belongs to.
enum SalesFlow {
  PROJECT
  RETAIL
}

// ---------------------------------------------------------------------
// Client / Lead / Opportunity — unified model (Fase 1 item 5) + item 2's
// migration target (localStorage -> here). Column shapes mirror
// src/types/client.ts, src/types/lead.ts, src/types/opportunity.ts as
// they exist today (that unification already happened at the TS layer;
// this schema is the DB-side counterpart).
// ---------------------------------------------------------------------

model Client {
  id                    String   @id @default(uuid())
  idCustomer            String   @unique @map("id_customer") // "kode customer"
  namaEntitas           String   @map("nama_entitas")
  kategoriClient        String   @map("kategori_client")
  owner                 String
  alamatLengkap         String?  @map("alamat_lengkap")
  koordinatGps          String?  @map("koordinat_gps")
  nomorTelepon          String?  @map("nomor_telepon")
  emailResmi            String?  @map("email_resmi")
  // Fase 1 item 5 (unify Client data model, 23 Sep 2026): the healthcare/
  // BPJS-only fields this app inherited (idSatusehat/idFaskesBpjs/
  // statusAkreditasi/volumePasien/jumlahTempatTidur) were removed --
  // Onduline has no equivalent concept, and jumlahTempatTidur (bed count)
  // was silently feeding AILeadScoring/AISmartRecommendations' deal-size
  // math. npwpFaskes/sistemLama were kept and renamed below (npwp/
  // vendorSebelumnya) since they map to real, generic business concepts.
  // See prisma/migrations/20260923100000_unify_client_data_model.
  namaPic               String?  @map("nama_pic")
  jabatanPic            String?  @map("jabatan_pic")
  whatsappPic           String?  @map("whatsapp_pic")
  statusHubungan        String?  @map("status_hubungan")
  paketAktif            String?  @map("paket_aktif")
  modulTambahan         String?  @map("modul_tambahan")
  statusKontrak         String?  @map("status_kontrak")
  statusSubscription    String?  @map("status_subscription")
  tanggalMulaiLangganan String?  @map("tanggal_mulai_langganan")
  tanggalHabisKontrak   String?  @map("tanggal_habis_kontrak")
  totalNilaiKontrak     String?  @map("total_nilai_kontrak")
  fileKontrakDigital    String?  @map("file_kontrak_digital")
  statusEsign           String?  @map("status_esign")
  npwp                  String?  @map("npwp")
  vendorSebelumnya      String?  @map("vendor_sebelumnya")

  // New with Fase 1: which hierarchy/flow this client belongs to (Bab 4/5).
  salesFlow     SalesFlow?
  distributorId String?      @map("distributor_id")
  distributor   Distributor? @relation(fields: [distributorId], references: [id])
  storeId       String?      @map("store_id")
  store         Store?       @relation(fields: [storeId], references: [id])

  // Bab 10 gap #1 ("Client tanpa approval workflow") -- same shape as
  // Distributor/Store's Bab 9 approval workflow. Default APPROVED (not
  // PENDING) so clients created before this migration aren't retroactively
  // treated as pending -- api/handler.ts's POST always sets PENDING
  // explicitly for every new client going forward.
  status        ApprovalStatus @default(APPROVED)
  submittedById String?        @map("submitted_by_id")
  submittedBy   User?          @relation("ClientSubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime?      @map("submitted_at")
  decidedById   String?        @map("decided_by_id")
  decidedBy     User?          @relation("ClientDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?      @map("decided_at")
  rejectionNote String?        @map("rejection_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  opportunities Opportunity[]

  // Bab 16.5 -- Organisation Tree / Influence Mapping & Customer
  // Intelligence (24 Sep 2026, lihat catatan desain di ClientContact/
  // ClientIntelligence di bawah). namaPic/jabatanPic/statusHubungan di
  // atas TETAP ADA (bukan dihapus) sebagai ringkasan cepat satu kontak
  // utama untuk tampilan list -- tidak semua Client akan langsung diisi
  // org tree lengkap, jadi kolom lama ini tetap jadi fallback yang valid.
  contacts       ClientContact[]
  intelligence   ClientIntelligence?
  // Bab 16.5 lanjutan (24 Sep 2026): log komunikasi/interaksi nyata,
  // menggantikan tab "Komunikasi" yang sebelumnya cuma state lokal
  // frontend (useState, tidak pernah tersimpan). SENGAJA model terpisah
  // dari OpportunityActivity (bukan reuse) -- lihat catatan lengkap di
  // model ClientCommunication di bawah.
  communications ClientCommunication[]
  // Bab 30 lanjutan -- lihat catatan lengkap di model Contract di bawah.
  contracts      Contract[]

  @@map("clients")
  @@index([status])
}

enum LeadStatus {
  NEW         @map("new")
  CONTACTED   @map("contacted")
  QUALIFIED   @map("qualified")
  PROPOSAL    @map("proposal")
  NEGOTIATION @map("negotiation")
  WON         @map("won")
  LOST        @map("lost")
}

model Lead {
  id          String     @id @default(uuid())
  name        String
  company     String
  email       String?
  phone       String?
  status      LeadStatus @default(NEW)
  value       Decimal    @db.Decimal(14, 2)
  source      String?
  assignedTo  String?    @map("assigned_to")
  lastContact DateTime?  @map("last_contact")
  notes       String?
  territoryId String?    @map("territory_id")
  territory   Territory? @relation(fields: [territoryId], references: [id])

  // Same rationale as Opportunity.extra below: LeadManagement.tsx's
  // multi-contact editor (`companies[]`, singular `position`) has no
  // dedicated columns here, matching today's localStorage behavior
  // (whatever shape the UI hands it gets stored as-is). Discovered when
  // wiring this module to the real API — see git history.
  extra Json?

  createdAt DateTime @default(now()) @map("created_at")

  opportunities Opportunity[]

  @@map("leads")
  @@index([territoryId])
}

enum OpportunityStage {
  PROSPECTING @map("prospecting")
  PROPOSAL    @map("proposal")
  NEGOTIATION @map("negotiation")
  CLOSED_WON  @map("closed-won")
  CLOSED_LOST @map("closed-lost")
}

enum OpportunityStatus {
  OPEN @map("open")
  WON  @map("won")
  LOST @map("lost")
}

model Opportunity {
  id            String  @id @default(uuid())
  name          String
  leadId        String? @map("lead_id")
  lead          Lead?   @relation(fields: [leadId], references: [id])
  // Kept as free text (matches today's UI/data); clientId is the new,
  // optional link — see the modeling note at the top of this file.
  clientId      String? @map("client_id")
  client        Client? @relation(fields: [clientId], references: [id])
  clientName    String  @map("client_name")
  contactPerson String  @map("contact_person")
  email         String?
  phone         String?

  totalValue  Decimal @default(0) @map("total_value") @db.Decimal(14, 2)
  currency    String  @default("IDR")
  probability Int     @default(0)

  createdDate     DateTime? @map("created_date")
  closeDate       DateTime  @map("close_date")
  actualCloseDate DateTime? @map("actual_close_date")

  stage       OpportunityStage  @default(PROSPECTING)
  status      OpportunityStatus @default(OPEN)
  lossReason  String?           @map("loss_reason")
  closeReason String?           @map("close_reason")
  closeDetail String?           @map("close_detail")

  ownerId   String? @map("owner_id")
  owner     User?   @relation("OpportunityOwner", fields: [ownerId], references: [id])
  ownerName String  @map("owner_name")

  source      String?
  description String?
  notes       String?

  nextFollowUpDate DateTime? @map("next_follow_up_date")
  reminderSent     Boolean   @default(false) @map("reminder_sent")

  // Bab 5: sales project (B2B) vs sales retail — which flow this
  // opportunity belongs to.
  salesFlow SalesFlow? @map("sales_flow")

  territoryId String?     @map("territory_id")
  territory   Territory?  @relation(fields: [territoryId], references: [id])

  // The ~40 optional Overview/Commercial/Technical-Detail fields from
  // src/types/opportunity.ts (opportunityMaturity, budgetStatus,
  // forecastType, salesStage, functionFit, etc.) — see modeling note.
  extra Json?

  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products   OpportunityProduct[]
  activities OpportunityActivity[]
  // Bab 30 lanjutan -- 1:1, lihat catatan lengkap di model Contract di
  // bawah (opportunityId di Contract di-@unique-kan).
  contract   Contract?

  @@map("opportunities")
  @@index([status])
  @@index([ownerId])
  @@index([territoryId])
}

model OpportunityProduct {
  id            String      @id @default(uuid())
  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  productId     String?     @map("product_id")
  product       Product?    @relation(fields: [productId], references: [id])
  productName   String      @map("product_name")
  quantity      Int
  unitPrice     Decimal     @map("unit_price") @db.Decimal(14, 2)
  totalPrice    Decimal     @map("total_price") @db.Decimal(14, 2)

  @@map("opportunity_products")
}

model OpportunityActivity {
  id            String      @id @default(uuid())
  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          String
  description   String
  createdBy     String?     @map("created_by")
  createdAt     DateTime    @default(now()) @map("created_at")

  // Bab 16.5 (24 Sep 2026): opsional -- kalau aktivitas ini adalah
  // pertemuan dengan salah satu kontak di org tree client-nya, dicatat di
  // sini supaya "jumlah pertemuan" per kontak (ClientContact) bisa
  // dihitung dari data yang sudah ada, bukan tabel counter terpisah yang
  // gampang tidak sinkron. Tetap opsional -- aktivitas lama/general tidak
  // wajib punya kontak spesifik.
  contactId String?        @map("contact_id")
  contact   ClientContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@map("opportunity_activities")
  @@index([contactId])
}

// ---------------------------------------------------------------------
// Task — Bab 8 gap 2 ("Tidak ada verifikasi display produk di toko" /
// "foto toko bertanggal"). checkInLat/Lng/At/PhotoUrl already existed as
// schema-level groundwork; checkInAccuracy and locationValidated are new
// here, added because TaskManagement.tsx's frontend Task interface
// already had them (a real GPS check-in flow was already built there,
// localStorage-only) with nowhere on the server to land.
//
// This model was previously just the check-in groundwork -- Task itself
// was never wired to a real backend (comment used to say "the check-in
// UI feature itself is not one of Fase 1's 5 items"). Implementing the
// photo half of check-in needs a real Task row to attach to, so this
// pass gives Task the same full CRUD treatment as Products/Leads/
// Opportunities got earlier: real columns for the fields every task
// always has (status/priority/type/dueDate/assignedTo/createdBy/
// createdDate/category/completedDate), and `extra Json?` for the
// long-tail ones that are either genuinely nested (subtasks) or a soft
// link that doesn't need referential integrity yet (relatedTo,
// parentTaskId) -- same reasoning as Lead's companies/position.
// ---------------------------------------------------------------------

enum TaskStatus {
  TODO        @map("todo")
  IN_PROGRESS @map("in-progress")
  COMPLETED   @map("completed")
}

enum TaskPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")
}

enum TaskType {
  VISIT @map("visit")
  CALL  @map("call")
  EMAIL @map("email")
  OTHER @map("other")
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  type        TaskType     @default(OTHER)
  category    String?
  dueDate     DateTime?    @map("due_date")
  completedDate DateTime?  @map("completed_date")

  assignedTo String? @map("assigned_to") // free text (matches today's UI) -- see modeling note
  createdBy  String? @map("created_by")

  opportunityId String?      @map("opportunity_id")
  storeId       String?      @map("store_id")
  store         Store?       @relation(fields: [storeId], references: [id])
  ownerId       String?      @map("owner_id")
  owner         User?        @relation("TaskOwner", fields: [ownerId], references: [id])

  checkInLat        Float?    @map("check_in_lat")
  checkInLng        Float?    @map("check_in_lng")
  checkInAt         DateTime? @map("check_in_at")
  checkInPhotoUrl   String?   @map("check_in_photo_url") // "foto display toko dengan tanggal & jam"
  checkInAccuracy   Float?    @map("check_in_accuracy") // GPS accuracy radius in meters, from Geolocation API
  locationValidated Boolean?  @map("location_validated") // false = check-in saved but location permission was denied

  // tags[], subtasks[], relatedTo, parentTaskId -- see modeling note above.
  extra Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tasks")
  @@index([status])
  @@index([ownerId])
}

// ---------------------------------------------------------------------
// Product — ported from db/migrations/0001_unified_product_model.sql,
// originally a software/physical supertype-subtype split. The software
// line (ProductType, ProductSoftwareAttrs, BillingCycle, DeploymentType)
// was removed 23 Sep 2026: Onduline is a physical building-materials
// distributor only, zero software products were ever seeded (see
// prisma/seed.ts history), and the concept was inherited from an
// earlier healthcare-software assumption that never applied to this
// business. RBAC + audit apply on top of this via User/AuditLogEntry,
// which didn't exist when the original file was written.
// ---------------------------------------------------------------------

enum ProductStatus {
  ACTIVE       @map("active")
  DISCONTINUED @map("discontinued")
}

// ---------------------------------------------------------------------
// Product catalog hierarchy for the physical (Onduline) line — Bab 8/16
// gap 3: "Product Catalog belum mencerminkan 5 kategori produk nyata
// dengan variasi teknis per kategori." Bab 16's full hierarchy is
// Category -> Family -> Product -> Variant -> SKU -> Packaging/UOM;
// implemented here at the depth the source document actually has real
// content for, not speculatively beyond it:
// - ProductCategory / ProductFamily are real tables (Bab 16 explicitly
//   asks for product_categories/product_families) so the 4 categories
//   Bab 16 itself says have no catalog yet (waterproofing, photovoltaic,
//   green roof, aksesoris) can be added later without a migration.
// - Product stays the SKU-level row (it already carries price/stock/
//   sold, which covers what Bab 16 calls product_prices/product_stocks)
//   rather than splitting those into their own tables with no real data
//   to seed them with yet.
// - Variant is a label on Product (variantLabel), not its own table —
//   Bab 16's own SKU example (ONDV-SR) only ever combines Family+Variant
//   as a code, never shows a Variant with independent attributes of its
//   own.
// - Deliberately NOT built: sku_uoms, sku_packagings,
//   sku_packaging_conversions, sku_barcodes, product_logistics,
//   product_accessories. Bab 16 names these but the document has no
//   concrete example data for any of them, and it explicitly flags its
//   own SKU codes as unverified ("bukan SKU resmi Onduline"). Adding six
//   empty tables now would be modeling ahead of any real requirement —
//   revisit once there's an actual UOM/packaging/barcode need.
// - The software product line (ProductSoftwareAttrs) that used to sit
//   alongside this was removed 23 Sep 2026 — see the Product model
//   comment above. This hierarchy only ever applies via the optional
//   familyId on Product.
// ---------------------------------------------------------------------

model ProductCategory {
  id   String @id @default(uuid())
  code String @unique // "ATAP", "WATERPROOFING", "PHOTOVOLTAIC", "GREEN_ROOF", "ACCESSORIES"
  name String

  families ProductFamily[]

  @@map("product_categories")
}

model ProductFamily {
  id         String          @id @default(uuid())
  categoryId String          @map("category_id")
  category   ProductCategory @relation(fields: [categoryId], references: [id])
  code       String          @unique // "ONDV", "ONDC", "ONDT", "ONDUC", "BARD"
  name       String // "ONDUVILLA"
  type       String // "Genteng Bitumen" — descriptive type, Bab 16's table

  products Product[]

  @@map("product_families")
}

// Bab 16: "SKU Lifecycle: Draft -> Pending Approval -> Active ->
// Temporarily Unavailable -> Discontinued -> Archived" — a second,
// SKU-specific approval gate alongside Bab 9's distributor/store one.
// Deliberately separate from ProductStatus: this only applies to
// physical/family-linked products, so widening the shared enum to six
// values every product would never use isn't worth the coupling.
enum SkuLifecycleStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  TEMPORARILY_UNAVAILABLE
  DISCONTINUED
  ARCHIVED
}

model Product {
  id          String        @id @default(uuid())
  sku         String        @unique
  name        String
  category    String
  price       Decimal       @db.Decimal(14, 2)
  currency    String        @default("IDR")
  description String?
  status      ProductStatus @default(ACTIVE)
  stock       Int           @default(0)
  features    String[]      @default([])
  sold        Int           @default(0)

  // Bab 16 hierarchy — only ever set for physical/Onduline-family
  // products; null for the software line.
  familyId     String?             @map("family_id")
  family       ProductFamily?      @relation(fields: [familyId], references: [id])
  variantLabel String?             @map("variant_label") // e.g. "Shaded Red"
  skuLifecycle SkuLifecycleStatus? @map("sku_lifecycle")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  physicalAttrs      ProductPhysicalAttrs?
  performanceTargets PerformanceTarget[]
  opportunityLines   OpportunityProduct[]

  @@map("products")
  @@index([category])
  @@index([status])
  @@index([familyId])
}

model ProductPhysicalAttrs {
  productId     String   @id @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitOfMeasure String   @map("unit_of_measure")
  color         String?
  specification String?
  weightKg      Decimal? @map("weight_kg") @db.Decimal(10, 3)

  @@map("product_physical_attrs")
}

// ---------------------------------------------------------------------
// Sales reps / territories / performance targets — ported from the same
// SQL file. The exclusive-arc check (exactly one of productId/
// salesRepId/territoryId set) can't be expressed in the Prisma schema
// language itself; keep enforcing it with the same raw-SQL CHECK
// constraint the old migration used, added as a `migration.sql` edit
// once `prisma migrate dev` generates the base migration.
// ---------------------------------------------------------------------

model SalesRep {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String
  createdAt DateTime @default(now()) @map("created_at")

  performanceTargets PerformanceTarget[]
  commissionRecords  CommissionRecord[]

  @@map("sales_reps")
}

// Bab-follow-up (business decision confirmed with user): assignedTo +
// coverage added as real columns; leads/opportunities are NOT stored here
// -- they're computed at read time from Lead.territoryId/
// Opportunity.territoryId (see handleTerritories' GET in api/handler.ts),
// same "derive, don't duplicate" approach as PerformanceTarget's
// achievementRate. This is why Lead and Opportunity below both gained a
// territoryId -- before this, neither had ANY link to a territory at
// all, so "computed automatically" was not actually possible without it.
model Territory {
  id         String   @id @default(uuid())
  name       String
  region     String
  assignedTo String?  @map("assigned_to")
  coverage   Float    @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  performanceTargets PerformanceTarget[]
  leads              Lead[]
  opportunities      Opportunity[]

  @@map("territories")
}

model PerformanceTarget {
  id          String     @id @default(uuid())
  productId   String?    @map("product_id")
  product     Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  salesRepId  String?    @map("sales_rep_id")
  salesRep    SalesRep?  @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  territoryId String?    @map("territory_id")
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  period      DateTime   @db.Date // first day of the month, e.g. 2026-09-01
  target      Decimal    @db.Decimal(14, 2)
  actual      Decimal    @default(0) @db.Decimal(14, 2)
  forecast    Decimal?   @db.Decimal(14, 2)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("performance_targets")
  @@unique([productId, period])
  @@unique([salesRepId, period])
  @@unique([territoryId, period])
}

enum CommissionStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  PAID     @map("paid")
}

model CommissionRecord {
  id              String           @id @default(uuid())
  salesRepId      String           @map("sales_rep_id")
  salesRep        SalesRep         @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  period          DateTime         @db.Date
  baseCommission  Decimal          @map("base_commission") @db.Decimal(14, 2)
  bonuses         Decimal          @db.Decimal(14, 2)
  totalCommission Decimal          @map("total_commission") @db.Decimal(14, 2)
  status          CommissionStatus @default(PENDING)
  deals           Int
  paymentDate     DateTime?        @map("payment_date")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("commission_records")
}

// ---------------------------------------------------------------------
// Audit trail — src/services/api.ts already reserves a localStorage key
// for this (LS_KEYS.AUDIT_TRAIL); this is its real-backend home.
// ---------------------------------------------------------------------

model AuditLogEntry {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_log_entries")
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------
// Bab 10 gap #3 (Rencana Insight doc): DiscountApprovalSystem.tsx already
// had a full multi-level approval UI (margin calculation, approval
// levels, counter-offer, conditional approval) but every request lived
// only in a hardcoded useState array -- approve/reject never even
// updated that in-memory array, only showed a toast. This is its real
// backend home.
//
// opportunityId/requestedById are kept as plain (unrelated) strings
// rather than Prisma relations, matching Task.assignedTo's "free text"
// convention elsewhere in this schema -- this keeps the migration
// self-contained (no changes to the existing User/Opportunity models),
// which matters here because this migration cannot be verified with
// `prisma generate`/`prisma migrate` from this sandbox (no network path
// to binaries.prisma.sh or the Neon host) and must be applied manually.
enum DiscountApprovalStatus {
  PENDING       @map("pending")
  APPROVED      @map("approved")
  REJECTED      @map("rejected")
  EXPIRED       @map("expired")
  COUNTER_OFFER @map("counter-offer")
}

enum DiscountStepAction {
  PENDING       @map("pending")
  APPROVED      @map("approved")
  REJECTED      @map("rejected")
  COUNTER_OFFER @map("counter-offer")
}

model DiscountApprovalRequest {
  id              String                   @id @default(uuid())
  requestNumber   String                   @unique @map("request_number")
  clientName      String                   @map("client_name")
  opportunityId   String?                  @map("opportunity_id")
  productName     String                   @map("product_name")
  originalPrice   Decimal                  @map("original_price") @db.Decimal(14, 2)
  discountPercent Decimal                  @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal                  @map("discount_amount") @db.Decimal(14, 2)
  finalPrice      Decimal                  @map("final_price") @db.Decimal(14, 2)
  requestedById   String?                  @map("requested_by_id")
  requestedByName String                   @map("requested_by_name")
  requestedDate   DateTime                 @default(now()) @map("requested_date")
  reason          String
  status          DiscountApprovalStatus   @default(PENDING)
  currentApprover String?                  @map("current_approver")
  approvalLevel   Int                      @default(1) @map("approval_level")
  urgency         String                   @default("medium")
  validUntil      DateTime?                @map("valid_until")
  originalMargin  Decimal                  @map("original_margin") @db.Decimal(5, 2)
  proposedMargin  Decimal                  @map("proposed_margin") @db.Decimal(5, 2)
  region          String?
  conditions      String?
  steps           DiscountApprovalStep[]
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@map("discount_approval_requests")
}

model DiscountApprovalStep {
  id                  String                  @id @default(uuid())
  requestId           String                  @map("request_id")
  request             DiscountApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  level               Int
  approverName        String                  @map("approver_name")
  approverRole        String                  @map("approver_role")
  action              DiscountStepAction      @default(PENDING)
  decidedAt           DateTime?               @map("decided_at")
  comment             String?
  counterOfferPercent Decimal?                @map("counter_offer_percent") @db.Decimal(5, 2)
  conditionsAdded     String?                 @map("conditions_added")
  createdAt           DateTime                @default(now()) @map("created_at")

  @@map("discount_approval_steps")
  @@index([requestId])
}


// ---------------------------------------------------------------------
// Bab 30 lanjutan (24 Sep 2026, hasil deep review + smoke test grup menu
// Sales Pipeline) -- Contract module sebelumnya 100% palsu: Contract.tsx
// fetch dari `contractsApi.getAll()` (fallback ke localStorage, tidak
// pernah ada endpoint /api/contracts di backend), dan ContractForm.tsx
// submit ke `https://mock-project-id.supabase.co/...` yang jelas-jelas
// tidak pernah dijawab siapa pun -- setiap create/edit kontrak diam-diam
// gagal total. Ini rumah backend sungguhan untuk fitur itu.
//
// clientId/opportunityId sengaja dibuat relasi Prisma asli (bukan free
// text seperti opportunityId di DiscountApprovalRequest) supaya seed data
// dummy (Bab 30 task #22) bisa benar-benar menautkan Contract ke Client/
// Opportunity Closed-Won yang sudah ada -- itu salah satu poin utama
// permintaan user ("data dummy yang terhubung dengan yang lain").
// opportunityId dibuat @unique karena satu opportunity yang sudah Closed
// Won paling banyak menghasilkan satu kontrak resmi (1:1), sama seperti
// pola clientId di Opportunity.
//
// Sama seperti DiscountApprovalRequest: migration ini tidak bisa
// diverifikasi dengan `prisma generate`/`prisma migrate` dari sandbox ini
// (tidak ada jalur jaringan ke binaries.prisma.sh dari VM device_bash) --
// harus dijalankan manual (`npx prisma migrate deploy`) dari mesin yang
// punya akses jaringan penuh (mis. langsung oleh user, atau lewat step
// build Vercel) sebelum fitur ini benar-benar hidup di production.
enum ContractStatus {
  DRAFT      @map("draft")
  PENDING    @map("pending")
  ACTIVE     @map("active")
  EXPIRED    @map("expired")
  TERMINATED @map("terminated")
}

model Contract {
  id             String         @id @default(uuid())
  contractNumber String         @unique @map("contract_number")
  clientId       String?        @map("client_id")
  client         Client?        @relation(fields: [clientId], references: [id])
  clientName     String         @map("client_name")
  company        String
  opportunityId  String?        @unique @map("opportunity_id")
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id])
  product        String
  value          Decimal        @db.Decimal(14, 2)
  startDate      DateTime       @map("start_date")
  endDate        DateTime       @map("end_date")
  status         ContractStatus @default(DRAFT)
  signedBy       String         @map("signed_by")
  salesPerson    String         @map("sales_person")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@map("contracts")
  @@index([clientId])
  @@index([status])
}


// ---------------------------------------------------------------------
// Bab 16.5 -- Organisation Tree & Influence Mapping (24 Sep 2026).
//
// Client sebelumnya cuma punya SATU kontak (namaPic/jabatanPic di atas)
// -- tidak cukup untuk B2B selling nyata, di mana keputusan biasanya
// melibatkan beberapa orang (buying committee) dan tim sales sering kalah
// bukan karena kalah produk, tapi karena cuma dekat dengan satu orang
// yang ternyata bukan pengambil keputusan ("single-threaded deal").
// ClientContact mengisi celah itu: banyak kontak per Client, masing-
// masing dengan peran pengaruhnya sendiri (influenceRole) dan status
// hubungan (relationshipStatus) -- terpisah dari struktur pelaporan
// (reportsToId, buat "organisation tree"-nya sendiri, siapa lapor ke
// siapa). Dua sumbu ini sengaja independen: seorang Direktur (posisi
// tinggi di tree) belum tentu Decision Maker untuk pembelian atap/produk
// Onduline -- bisa saja itu didelegasikan ke Technical Advisor.
//
// "Jumlah pertemuan" tidak disimpan sebagai counter di sini -- dihitung
// dari OpportunityActivity.contactId (lihat di atas) supaya selalu
// sinkron dengan riwayat aktivitas asli, bukan angka yang bisa basi.
// ---------------------------------------------------------------------

enum InfluenceRole {
  DECISION_MAKER    @map("decision-maker")
  APPROVER          @map("approver")
  INFLUENCER        @map("influencer")
  TECHNICAL_ADVISOR @map("technical-advisor")
  CONSULTANT        @map("consultant")
}

enum RelationshipStatus {
  POSITIVE @map("positive")
  NEUTRAL  @map("neutral")
  NEGATIVE @map("negative")
}

// Kedekatan hubungan -- sengaja skala manual sederhana yang diisi sales
// rep sendiri (lihat catatan desain: skor otomatis dari frekuensi kontak
// gampang menyesatkan kalau data pertemuannya masih tipis), bukan field
// bebas supaya tetap bisa difilter/dikelompokkan di UI.
enum RelationshipCloseness {
  BARU_KENAL @map("baru-kenal") // baru dikenal, interaksi minim
  KENAL_BAIK @map("kenal-baik") // sudah beberapa kali interaksi
  CHAMPION   @map("champion") // pendukung aktif, sering membantu deal
}

model ClientContact {
  id       String @id @default(uuid())
  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  nama     String
  jabatan  String?
  email    String?
  telepon  String?
  whatsapp String?

  influenceRole      InfluenceRole          @map("influence_role")
  relationshipStatus RelationshipStatus     @default(NEUTRAL) @map("relationship_status")
  closeness          RelationshipCloseness  @default(BARU_KENAL)

  // Struktur organisasi (siapa lapor ke siapa) -- terpisah dari
  // influenceRole, lihat catatan desain di atas. Self-relation supaya
  // org tree bisa direnderkan langsung dari data ini tanpa tabel
  // tambahan.
  reportsToId String?         @map("reports_to_id")
  reportsTo   ClientContact?  @relation("ClientContactHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     ClientContact[] @relation("ClientContactHierarchy")

  notes String?

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ClientContactCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activities     OpportunityActivity[]
  communications ClientCommunication[]

  @@map("client_contacts")
  @@index([clientId])
  @@index([reportsToId])
}

// ---------------------------------------------------------------------
// Bab 16.5 -- Customer Intelligence MVP (24 Sep 2026).
//
// Digabung dari dua sumber: bagian INTERNAL (riwayat opportunity/
// contract/aktivitas) tidak perlu tabel baru -- itu query agregasi dari
// data yang sudah ada (Opportunity, OpportunityActivity, Client). Tabel
// ini cuma untuk bagian EKSTERNAL: riset manual yang diisi sales rep
// sendiri (profil bisnis, skala, kompetitor, dst.) -- SENGAJA tidak ada
// integrasi API/scraping pihak ketiga di MVP ini (lihat diskusi insight
// sebelumnya: biaya & risiko legal data eksternal otomatis tidak
// sepadan untuk tahap ini). One-to-one dengan Client -- satu client,
// satu lembar intelijen yang terus diperbarui, bukan riwayat versi.
// ---------------------------------------------------------------------

model ClientIntelligence {
  id       String @id @default(uuid())
  clientId String @unique @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  profilBisnis        String? @map("profil_bisnis") // industri, skala usaha, model bisnis singkat
  proyekBerjalan       String? @map("proyek_berjalan") // proyek yang sedang/akan berjalan yang relevan
  kompetitorEksisting  String? @map("kompetitor_eksisting") // vendor/produk kompetitor yang dipakai/dipertimbangkan
  sumberInformasi      String? @map("sumber_informasi") // dari mana info ini didapat (referensi, web, obrolan, dst)
  catatanTambahan      String? @map("catatan_tambahan")
  // Link ke sumber eksternal (company profile, berita, LinkedIn, dst) --
  // [{label, url}], lihat src/types untuk shape-nya. Json bukan tabel
  // terpisah karena ini murni daftar tautan referensi, tidak butuh query
  // relasional.
  links Json?

  updatedById String? @map("updated_by_id")
  updatedBy   User?   @relation("ClientIntelligenceUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("client_intelligence")
}

// ---------------------------------------------------------------------
// Bab 16.5 lanjutan (24 Sep 2026) -- Komunikasi/interaksi client jadi
// data sungguhan.
//
// Sebelum ini, tab "Komunikasi" di ClientDetailDialog cuma `useState`
// lokal di frontend (5 item contoh hardcoded, hilang setiap refresh,
// tidak pernah benar-benar tersimpan) -- ditemukan saat menutup gap
// "jumlah pertemuan selalu 0" untuk fitur Organisation Tree.
//
// KENAPA MODEL TERPISAH dari OpportunityActivity (bukan reuse):
// OpportunityActivity.opportunityId WAJIB diisi (tidak nullable) --
// activity di sana selalu menempel ke satu Opportunity tertentu, dipakai
// "Catat Pertemuan" di ClientOrgTreePanel yang memang tentang tahap
// deal. Komunikasi client SENGAJA harus tetap bisa dicatat tanpa
// Opportunity sama sekali (keputusan eksplisit user, 24 Sep 2026) --
// misalnya follow-up rutin ke client existing yang belum ada Opportunity
// aktif. Memaksa satu model untuk keduanya berarti salah satu kehilangan
// fleksibilitasnya, jadi dipisah: ClientCommunication milik Client
// langsung, contactId opsional (tidak wajib pilih kontak spesifik).
//
// "Jumlah pertemuan" pada ClientContact sekarang dihitung dari GABUNGAN
// OpportunityActivity.contactId + ClientCommunication.contactId (lihat
// handleClientContacts di api/handler.ts) -- supaya insight itu
// mencerminkan semua interaksi tercatat, bukan cuma yang kebetulan
// menempel ke Opportunity.
enum CommunicationType {
  TELEPON  @map("Telepon")
  EMAIL    @map("Email")
  MEETING  @map("Meeting")
  WHATSAPP @map("WhatsApp")
  VISIT    @map("Visit")
}

model ClientCommunication {
  id       String @id @default(uuid())
  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type        CommunicationType
  title       String
  description String
  // Tag bebas tambahan (mis. "Hot Lead", "Follow-up") -- TIDAK termasuk
  // label tipe komunikasi (itu sudah di kolom `type`); frontend
  // menggabungkan lagi keduanya saat render supaya tampilan badge sama
  // seperti sebelumnya (categories = [type, ...tagsBebas]).
  categories Json?

  // Opsional -- kalau komunikasi ini melibatkan salah satu kontak di org
  // tree (lihat catatan di atas kenapa ini terpisah dari
  // OpportunityActivity.contactId).
  contactId String?        @map("contact_id")
  contact   ClientContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ClientCommunicationCreatedBy", fields: [createdById], references: [id])

  // Kapan komunikasi ini TERJADI (diisi user lewat form, bisa tanggal apa
  // saja) -- beda dari createdAt (kapan record-nya dibuat di sistem).
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("client_communications")
  @@index([clientId])
  @@index([contactId])
}
