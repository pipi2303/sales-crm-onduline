# Fase 1 — backend & auth nyata. Copy to .env.local and fill in once a
# Postgres project exists (Vercel Postgres / Neon, per the plan doc Bab 15).
# Nothing in this repo has been run against a live database yet.

# postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=

# HMAC/signing secret for issuing session tokens server-side (Fase 1 item 3).
AUTH_SECRET=

# Bab 14 Fase C: AI Assistant sungguhan (/api/ai-chat), panggilan nyata
# ke Gemini API. Tanpa GEMINI_API_KEY, endpoint akan menjawab 503 dengan
# pesan yang jelas (bukan gagal diam-diam).
# Dapatkan API key gratis dari https://aistudio.google.com/apikey
# (23 Sep 2026: sebelumnya pakai ANTHROPIC_API_KEY -- diganti ke Gemini
# karena akun Anthropic yang dipakai belum ada credit billing-nya).
GEMINI_API_KEY=

# Opsional -- model ID yang dipakai /api/ai-chat. Default: gemini-3.8-flash
AI_MODEL_ID=
