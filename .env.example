# Fase 1 — backend & auth nyata. Copy to .env.local and fill in once a
# Postgres project exists (Vercel Postgres / Neon, per the plan doc Bab 15).
# Nothing in this repo has been run against a live database yet.

# postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=

# HMAC/signing secret for issuing session tokens server-side (Fase 1 item 3).
AUTH_SECRET=

# Bab 14 Fase C: AI Assistant sungguhan (/api/ai-chat), panggilan nyata
# ke Anthropic Messages API. Tanpa ANTHROPIC_API_KEY, endpoint akan
# menjawab 503 dengan pesan yang jelas (bukan gagal diam-diam).
# Dapatkan API key dari https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Opsional -- model ID yang dipakai /api/ai-chat. Default: claude-sonnet-5
# (dikonfirmasi masih valid per dokumentasi Anthropic per 23 Sep 2026).
AI_MODEL_ID=
